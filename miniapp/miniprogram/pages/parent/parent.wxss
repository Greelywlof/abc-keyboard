.wrap { padding: 32rpx; background: #fff; min-height: 100vh; box-sizing: border-box; }
.gate { display: flex; flex-direction: column; align-items: center; gap: 28rpx; padding-top: 120rpx; font-size: 34rpx; }
.q { font-weight: bold; font-size: 44rpx; }
.in { border: 4rpx solid #d9d2ea; border-radius: 20rpx; width: 260rpx; height: 88rpx; font-size: 44rpx; text-align: center; }
.btn { background: #7c6cf0; color: #fff; padding: 18rpx 80rpx; border-radius: 999rpx; }
.h { font-size: 40rpx; font-weight: bold; margin-bottom: 20rpx; }
.h2 { font-size: 32rpx; font-weight: bold; margin: 40rpx 0 16rpx; }
.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.card { background: #f6f3ff; border-radius: 24rpx; padding: 20rpx 8rpx; text-align: center; }
.card .n { font-size: 52rpx; font-weight: bold; color: #7c6cf0; }
.card .s { font-size: 22rpx; color: #8a83a3; }
.muted { color: #8a83a3; font-size: 24rpx; margin-top: 12rpx; }
.bars { display: flex; align-items: flex-end; gap: 16rpx; height: 260rpx; }
.bar { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; font-size: 22rpx; color: #8a83a3; }
.bar .num { color: #3b3355; }
.bar .col { width: 100%; background: #7c6cf0; border-radius: 12rpx 12rpx 0 0; min-height: 4rpx; }
.bar.today .col { background: #ff7aa8; }
.ev { display: flex; gap: 16rpx; align-items: center; font-size: 28rpx; padding: 10rpx 0; border-bottom: 2rpx solid #f1eef8; flex-wrap: wrap; }
.ev .t { color: #8a83a3; } .ev .w { font-weight: bold; } .ev .sc { color: #7c6cf0; } .ev .weak { color: #e03131; font-size: 24rpx; }
.limits { display: flex; flex-wrap: wrap; gap: 12rpx; }
.lim { padding: 12rpx 24rpx; border-radius: 999rpx; background: #f6f3ff; font-size: 26rpx; }
.lim.on { background: #7c6cf0; color: #fff; }
